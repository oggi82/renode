// Test extension for POSIF_Hall: hall sensor inputs on P14.7, P14.6, P14.5 (README), routed to POSIF0.IN0B, IN1B, IN2B.
// The CCU80 is replaced by a stub that reports the period match flag of slice 2 (the example waits for it).
hall1: Miscellaneous.Button @ port14 7
    -> port14@7 | posif0@1

hall2: Miscellaneous.Button @ port14 6
    -> port14@6 | posif0@5

hall3: Miscellaneous.Button @ port14 5
    -> port14@5 | posif0@9

ccu80: Python.PythonPeripheral @ sysbus 0x40020000
    size: 0x1000
    initable: true
    filename: "tests/platforms/xmc4500/posif_ccu8_hall_stub.py"
