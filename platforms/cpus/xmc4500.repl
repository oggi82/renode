// Infineon XMC4500-F100x1024 (Cortex-M4F, 120 MHz, 1 MB Flash, 160 KB SRAM)
// Memory map taken from the XMC4500 reference manual; segment layout confirmed by the linker script of the test firmware.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    PerformanceInMips: 120
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xFC
    systickFrequency: 120000000
    IRQ -> cpu@0

// Program flash: the same 1 MB is visible through the cached (0x0800_0000) and the uncached (0x0C00_0000) segment.
// The cached segment is the (fast) storage; the uncached segment is a view of it whose writes are flash command cycles.
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

flashUncached: MTD.XMC4XXX_FlashArray @ sysbus 0x0C000000
    flash: flash
    controller: flashController

// PSRAM (segment 1), DSRAM1 (segment 2) and DSRAM2 (segment 3)
psram: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x10000

dsram1: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x10000

dsram2: Memory.MappedMemory @ sysbus 0x30000000
    size: 0x8000

// The SCU registers end below the ERU0 at 0x50004800; the combined service request is NVIC interrupt 0 (SCU_0)
scu: Miscellaneous.XMC4XXX_SCU @ sysbus <0x50004000, +0x800>
    nvic: nvic
    oscillatorFrequency: 12000000
    IRQ -> nvic@0

// Window watchdog; its pre-warning alarm and reset request are inputs of the SCU (service request PRWARN, system reset)
wdt: Timers.XMC4XXX_WDT @ sysbus 0x50008000
    scu: scu
    Alarm -> scu@0
    ResetRequest -> scu@4

// Real time clock of the hibernate domain; periodic and alarm events are SCU service requests (PI, AI), WakeupIRQ wakes from hibernate
rtc: Timers.XMC4XXX_RTC @ sysbus 0x50004A00
    scu: scu
    PeriodicIRQ -> scu@1
    AlarmIRQ -> scu@2
    WakeupIRQ -> scu@5

// Flash controller FLASH0: FSR/FCON/MARP/PROCONx and the command interpreter for the writes to the uncached flash segment
flashController: MTD.XMC4XXX_FlashController @ sysbus 0x58002000
    flash: flash
    IRQ -> nvic@12

// Ports of the XMC4500-F100 (LQFP-100): numberOfPins is the highest pin number + 1 (reference manual table 25-10), pinDisableResetValue (PDISC)
// has the pads of pins that are not bonded out in this package set. P5 and P6 only have pins in larger packages, P14 and P15 are analog
// input ports (PDISC writable, all pads disabled after reset). HWSEL reset: P0.7 (TDI) and P0.8 (TRST) select the debug interface, P2.1 (TDO).
port0: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028000
    numberOfPins: 13
    pinDisableResetValue: 0xE000
    hwselResetValue: 0x14000

port1: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028100
    numberOfPins: 16

port2: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028200
    numberOfPins: 16
    pinDisableResetValue: 0x3800
    hwselResetValue: 0x4

port3: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028300
    numberOfPins: 7
    pinDisableResetValue: 0xFF80

port4: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028400
    numberOfPins: 2
    pinDisableResetValue: 0xFFFC

port5: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028500
    numberOfPins: 8
    pinDisableResetValue: 0xFF78

port6: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028600
    numberOfPins: 7
    pinDisableResetValue: 0xFFFF

port14: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028E00
    numberOfPins: 16
    pinDisableResetValue: 0xFFFF
    analogPort: true

port15: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028F00
    numberOfPins: 16
    pinDisableResetValue: 0xFFFF
    analogPort: true

// USIC channels: UART (ASC), SPI (SSC) or I2C (IIC) selected by CCR.MODE. The six service request lines
// of a module (shared by both channels) are the NVIC interrupts 84-89 (USIC0), 90-95 (USIC1), 96-101 (USIC2)
usic0ch0: UART.XMC4XXX_USIC @ sysbus <0x40030000, +0x200>
    scu: scu
    [0-1] -> nvic@[84-85] | dlr@[46-47]
    [2-5] -> nvic@[86-89]

usic0ch1: UART.XMC4XXX_USIC @ sysbus <0x40030200, +0x200>
    scu: scu
    [0-5] -> nvic@[84-89]

usic1ch0: UART.XMC4XXX_USIC @ sysbus <0x48020000, +0x200>
    scu: scu
    [0-5] -> nvic@[90-95]

usic1ch1: UART.XMC4XXX_USIC @ sysbus <0x48020200, +0x200>
    scu: scu
    [0-1] -> nvic@[90-91] | dlr@[48-49]
    [2-5] -> nvic@[92-95]

usic2ch0: UART.XMC4XXX_USIC @ sysbus <0x48024000, +0x200>
    scu: scu
    [0-5] -> nvic@[96-101]

usic2ch1: UART.XMC4XXX_USIC @ sysbus <0x48024200, +0x200>
    scu: scu
    [0-5] -> nvic@[96-101]

// MultiCAN (CAN0); the eight service request lines SR0-SR7 are NVIC interrupts 76-83 (CAN0_0_IRQn ... CAN0_7_IRQn)
can0: CAN.XMC4XXX_CAN @ sysbus 0x48014000
    peripheralClockFrequency: 72000000
    [0-3] -> nvic@[76-79] | dlr@[42-45]
    [4-7] -> nvic@[80-83]

// VADC (groups G0-G3 and common block C0): group service requests G0SR0..G3SR3 are NVIC interrupts 18-33, C0SR0..C0SR3 are 14-17
vadc: Analog.XMC4XXX_VADC @ sysbus <0x40004000, +0x1400>
    nvic: nvic
    [0-15] -> nvic@[18-33] | dlr@[8-23]
    [16-19] -> nvic@[14-17] | dlr@[4-7]

// DAC with two channels; service requests 0 and 1 are NVIC interrupts 42 and 43
dac: Analog.XMC4XXX_DAC @ sysbus 0x48018000
    nvic: nvic
    [0-1] -> nvic@[42-43] | dlr@[28-29]

// Capture/Compare Units 4 (CCU40-CCU43): service request lines SR0-SR3 are NVIC interrupts 44-59, the slice outputs are connections 4-7
ccu40: Timers.XMC4XXX_CCU4 @ sysbus 0x4000C000
    scu: scu
    [0-1] -> nvic@[44-45] | dlr@[30-31]
    [2-3] -> nvic@[46-47]

ccu41: Timers.XMC4XXX_CCU4 @ sysbus 0x40010000
    scu: scu
    [0-1] -> nvic@[48-49] | dlr@[32-33]
    [2-3] -> nvic@[50-51]

ccu42: Timers.XMC4XXX_CCU4 @ sysbus 0x40014000
    scu: scu
    [0-1] -> nvic@[52-53] | dlr@[34-35]
    [2-3] -> nvic@[54-55]

ccu43: Timers.XMC4XXX_CCU4 @ sysbus 0x48004000
    scu: scu
    [0-1] -> nvic@[56-57] | dlr@[36-37]
    [2-3] -> nvic@[58-59]

// SCU trigger signals GSC40-GSC43 (CCUCON bits 0-3) drive input I of the matching CCU4 unit
scu:
    0 -> ccu40@8
    1 -> ccu41@8
    2 -> ccu42@8
    3 -> ccu43@8

// Position Interfaces POSIF0/POSIF1: SR0/SR1 are NVIC interrupts 68-71 (connections 7 and 8).
// OUT0-OUT5 (connections 0-5) drive CCU4 inputs of single slices (number 16 + 16 * slice + input letter), HSDA is ST0 of CCU40/41.
posif0: Miscellaneous.XMC4XXX_POSIF @ sysbus 0x40028000
    7 -> nvic@68
    8 -> nvic@69
    0 -> ccu40@20 | ccu40@36 | ccu40@52
    1 -> ccu40@21 | ccu40@37
    2 -> ccu40@43 | ccu40@53 | ccu42@20 | ccu42@36 | ccu42@52 | ccu42@68
    3 -> ccu40@22 | ccu40@38 | ccu40@54 | ccu40@68
    4 -> ccu40@39 | ccu40@55
    5 -> ccu40@69 | ccu42@21 | ccu42@37 | ccu42@53 | ccu42@69

posif1: Miscellaneous.XMC4XXX_POSIF @ sysbus 0x4002C000
    7 -> nvic@70
    8 -> nvic@71
    0 -> ccu41@20 | ccu41@36 | ccu41@52
    1 -> ccu41@21 | ccu41@37
    2 -> ccu41@43 | ccu41@53 | ccu43@20 | ccu43@36 | ccu43@52 | ccu43@68
    3 -> ccu41@22 | ccu41@38 | ccu41@54 | ccu41@68
    4 -> ccu41@39 | ccu41@55
    5 -> ccu41@69 | ccu43@21 | ccu43@37 | ccu43@53 | ccu43@69

// CCU4 status bits back to the POSIF: ST0 -> HSDA (hall sampling delay), ST1 -> MSETB (CCU40/41), ST0 of CCU42/43 -> MSETD
ccu40:
    4 -> posif0@12
    5 -> posif0@21

ccu41:
    4 -> posif1@12
    5 -> posif1@21

ccu42:
    4 -> posif0@23

ccu43:
    4 -> posif1@23

// Capture/Compare Units 8 (CCU80, CCU81): service request lines SR0-SR3 are NVIC interrupts 60-67 (connections 0-3),
// the slice outputs OUT00-OUT33 are connections 4-19. SR0 of CCU80 additionally drives VADC gating input M (CCU80.SR0, GPIO 16 + 12),
// which CCU8_TRIGGERED_VADC_MEASUREMENT selects as trigger source of the queue.
ccu80: Timers.XMC4XXX_CCU8 @ sysbus 0x40020000
    scu: scu
    0 -> nvic@60 | vadc@28
    [1-3] -> nvic@[61-63]

ccu81: Timers.XMC4XXX_CCU8 @ sysbus 0x40024000
    scu: scu
    [0-3] -> nvic@[64-67]

// SCU trigger signals GSC80/GSC81 (CCUCON bits 8-9) drive input H of the matching CCU8 unit
scu:
    8 -> ccu80@7
    9 -> ccu81@7

// Event Request Units; the service request outputs IOUT0-3 are the NVIC interrupts 1-4 (ERU0) and 5-8 (ERU1).
// ERU1 feeds IOUT2 and IOUT3 back to some of its own inputs.
eru0: Miscellaneous.XMC4XXX_ERU @ sysbus 0x50004800
    [0-3] -> nvic@[1-4]

eru1: Miscellaneous.XMC4XXX_ERU @ sysbus 0x40044000
    internalLoopback: true
    [0-3] -> nvic@[5-8]

// Pin to ERU input routing of the LQFP-100 package (XMC4500 LQFP100 table of xmc4_eru_map.h). The pins of a port have two kinds of
// outputs: 0..n-1 is the driven level, n..2n-1 the level seen by the peripherals; n is the numberOfPins of the port.
// ERU input numbers: channel*8 + 0..3 for A0-A3 and channel*8 + 4..7 for B0-B3.
port0:
    14 -> eru0@0
    13 -> eru0@4
    23 -> eru0@8
    22 -> eru0@12
    21 -> eru0@17
    20 -> eru0@21
    25 -> eru0@22
    17 -> eru0@23
    24 -> eru0@26
    19 -> eru0@30
    15 -> eru0@31
    18 -> eru1@24
    16 -> eru1@28

port1:
    21 -> eru0@16 | eru1@0
    20 -> eru0@20
    17 -> eru0@24
    16 -> eru0@28
    31 -> eru1@8
    19 -> eru1@16
    18 -> eru1@20

port2:
    21 -> eru0@2
    20 -> eru0@6
    16 -> eru0@7
    19 -> eru0@10
    18 -> eru0@14
    22 -> eru0@15
    17 -> eru1@4
    23 -> eru1@12

port3:
    9 -> eru0@1
    8 -> eru0@5
    13 -> eru0@25
    12 -> eru0@29


// Flexible CRC Engine (FCE), service request is NVIC interrupt 104
fce: CRC.XMC4XXX_FCE @ sysbus 0x50020000
    IRQ -> nvic@104

// DMA line router (inside the SCU address range) and the general purpose DMA units; GPDMA0 SR is NVIC 105, GPDMA1 SR is NVIC 110
dlr: DMA.XMC4XXX_DLR @ sysbus 0x50004900

gpdma0: DMA.XMC4XXX_GPDMA @ sysbus 0x50014000
    dlr: dlr
    firstDlrLine: 0
    numberOfChannels: 8
    IRQ -> nvic@105

gpdma1: DMA.XMC4XXX_GPDMA @ sysbus 0x50018000
    dlr: dlr
    firstDlrLine: 8
    numberOfChannels: 4
    IRQ -> nvic@110

// DMA request sources (numbering see XMC4XXX_DLR): CCU40-43 SR0/SR1, CAN SR0-3, DAC SR0/1, VADC, USIC0/1 SR0/1
