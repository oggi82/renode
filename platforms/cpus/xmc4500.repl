// Infineon XMC4500-F100x1024 (Cortex-M4F, 120 MHz, 1 MB Flash, 160 KB SRAM)
// Memory map taken from the XMC4500 reference manual; segment layout confirmed by the linker script of the test firmware.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    PerformanceInMips: 120
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xFC
    systickFrequency: 120000000
    IRQ -> cpu@0

// Program flash: the same 1 MB is visible through the cached (0x0800_0000) and the uncached (0x0C00_0000) segment.
// The cached segment is the (fast) storage; the uncached segment is a view of it whose writes are flash command cycles.
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

flashUncached: MTD.XMC4XXX_FlashArray @ sysbus 0x0C000000
    flash: flash
    controller: flashController

// PSRAM (segment 1), DSRAM1 (segment 2) and DSRAM2 (segment 3)
psram: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x10000

dsram1: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x10000

dsram2: Memory.MappedMemory @ sysbus 0x30000000
    size: 0x8000

scu: Miscellaneous.XMC4XXX_SCU @ sysbus 0x50004000
    nvic: nvic
    oscillatorFrequency: 12000000

// Flash controller FLASH0: FSR/FCON/MARP/PROCONx and the command interpreter for the writes to the uncached flash segment
flashController: MTD.XMC4XXX_FlashController @ sysbus 0x58002000
    flash: flash
    IRQ -> nvic@12

// Ports P0-P6 and P14-P15; P14 and P15 have analog inputs, their pins are disabled for digital use after reset
port0: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028000
    numberOfPins: 16

port1: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028100
    numberOfPins: 16

port2: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028200
    numberOfPins: 16

port3: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028300
    numberOfPins: 16

port4: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028400
    numberOfPins: 16

port5: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028500
    numberOfPins: 16

port6: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028600
    numberOfPins: 16

port14: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028E00
    numberOfPins: 16
    pinDisableResetValue: 0xFFFF

port15: GPIOPort.XMC4XXX_GPIOPort @ sysbus 0x48028F00
    numberOfPins: 16
    pinDisableResetValue: 0xFFFF

// USIC0 channel 0; the six service request lines of a USIC module are NVIC interrupts 84-89
usic0ch0: UART.XMC4XXX_UART @ sysbus <0x40030000, +0x200>
    [0-5] -> nvic@[84-89]

// MultiCAN (CAN0); the eight service request lines SR0-SR7 are NVIC interrupts 76-83 (CAN0_0_IRQn ... CAN0_7_IRQn)
can0: CAN.XMC4XXX_CAN @ sysbus 0x48014000
    peripheralClockFrequency: 72000000
    [0-7] -> nvic@[76-83]

// USIC1 channel 1: debug UART of the examples whose BSP uses XMC_UART1_CH1 (Flash_EEPROM); SR0-5 = NVIC 90-95
usic1ch1: UART.XMC4XXX_UART @ sysbus <0x48020200, +0x200>
    [0-5] -> nvic@[90-95]

// VADC (groups G0-G3 and common block C0): group service requests G0SR0..G3SR3 are NVIC interrupts 18-33, C0SR0..C0SR3 are 14-17
vadc: Analog.XMC4XXX_VADC @ sysbus <0x40004000, +0x1400>
    nvic: nvic
    [0-15] -> nvic@[18-33]
    [16-19] -> nvic@[14-17]

// DAC with two channels; service requests 0 and 1 are NVIC interrupts 42 and 43
dac: Analog.XMC4XXX_DAC @ sysbus 0x48018000
    nvic: nvic
    [0-1] -> nvic@[42-43]

// Capture/Compare Units 4 (CCU40-CCU43): service request lines SR0-SR3 are NVIC interrupts 44-59, the slice outputs are connections 4-7
ccu40: Timers.XMC4XXX_CCU4 @ sysbus 0x4000C000
    scu: scu
    [0-3] -> nvic@[44-47]

ccu41: Timers.XMC4XXX_CCU4 @ sysbus 0x40010000
    scu: scu
    [0-3] -> nvic@[48-51]

ccu42: Timers.XMC4XXX_CCU4 @ sysbus 0x40014000
    scu: scu
    [0-3] -> nvic@[52-55]

ccu43: Timers.XMC4XXX_CCU4 @ sysbus 0x48004000
    scu: scu
    [0-3] -> nvic@[56-59]

// SCU trigger signals GSC40-GSC43 (CCUCON bits 0-3) drive input I of the matching CCU4 unit
scu:
    0 -> ccu40@8
    1 -> ccu41@8
    2 -> ccu42@8
    3 -> ccu43@8

// Flexible CRC Engine (FCE), service request is NVIC interrupt 104
fce: CRC.XMC4XXX_FCE @ sysbus 0x50020000
    IRQ -> nvic@104

// DMA line router (inside the SCU address range) and the general purpose DMA units; GPDMA0 SR is NVIC 105, GPDMA1 SR is NVIC 110
dlr: DMA.XMC4XXX_DLR @ sysbus 0x50004900

gpdma0: DMA.XMC4XXX_GPDMA @ sysbus 0x50014000
    dlr: dlr
    firstDlrLine: 0
    numberOfChannels: 8
    IRQ -> nvic@105

gpdma1: DMA.XMC4XXX_GPDMA @ sysbus 0x50018000
    dlr: dlr
    firstDlrLine: 8
    numberOfChannels: 4
    IRQ -> nvic@110

// DMA request sources (numbering see XMC4XXX_DLR): CCU40-43 SR0/SR1, CAN SR0-3, DAC SR0/1, VADC, USIC0/1 SR0/1
ccu40:
    [0-1] -> dlr@[30-31]
ccu41:
    [0-1] -> dlr@[32-33]
ccu42:
    [0-1] -> dlr@[34-35]
ccu43:
    [0-1] -> dlr@[36-37]
can0:
    [0-3] -> dlr@[42-45]
dac:
    [0-1] -> dlr@[28-29]
vadc:
    [0-15] -> dlr@[8-23]
    [16-19] -> dlr@[4-7]
usic0ch0:
    [0-1] -> dlr@[46-47]
usic1ch1:
    [0-1] -> dlr@[48-49]
